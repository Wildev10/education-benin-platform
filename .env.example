# Copiez ce fichier en .env et remplissez les valeurs réelles.
# NE commitez JAMAIS .env — il contient vos secrets.

# Chaîne de connexion Neon (branche "dev" en local, "production" sur Vercel)
DATABASE_URL="postgresql://user:password@ep-xxxx-dev.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Secret Auth.js (générez avec : openssl rand -base64 32)
AUTH_SECRET="votre-secret-auth-32-caracteres-minimum"

# Clé API Gemini pour l'assistant IA
GEMINI_API_KEY="AIzaSy-votre-cle-gemini"

# "true" : l'assistant n'appelle jamais Gemini et répond uniquement avec l'analyseur
# local (mode sans IA). Vide ou absente : Gemini d'abord, mode sans IA en secours.
ASSISTANT_SANS_IA=""

# Hôtes de base de données à protéger (séparés par des virgules).
# Si DATABASE_URL pointe vers l'un de ces hôtes, les scripts d'écriture sont bloqués.
PROTECTED_DB_HOSTS="ep-xxxx-production.us-east-2.aws.neon.tech"

# DSN Sentry pour la surveillance des erreurs (facultatif en local, laisser vide pour désactiver)
NEXT_PUBLIC_SENTRY_DSN=""
