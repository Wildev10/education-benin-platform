# Modèle de .env.e2e.local, lu par les tests navigateur (npm run e2e).
# Copiez ce fichier en .env.e2e.local (ignoré par git) et remplissez-le.
#
# Compte directeur d'une base de DÉVELOPPEMENT : il ne fait pas partie des
# comptes de démonstration du README. Sans ces deux variables, les étapes
# directeur des scénarios sont ignorées.
E2E_DIRECTEUR_EMAIL=
E2E_DIRECTEUR_MOT_DE_PASSE=
