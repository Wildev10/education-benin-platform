// Prisma 7 : client généré dans src/generated/prisma (ignoré par git, recréé par
// `prisma generate` à l'installation). Importer depuis "@/generated/prisma/client".
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// La connexion du CLI est dans prisma.config.ts ; celle de l'application passe
// par le driver adapter de src/lib/prisma.ts.
datasource db {
  provider = "postgresql"
}

model Etudiant {
  id              String   @id @default(cuid())
  nom             String
  prenom          String
  dateNaissance   DateTime
  sexe            String
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id])
  niveau          String
  inscriptions    Inscription[]
  notes           Note[]
  alertes         Alerte[]
  absences        Absence[]
  compte          User?
  createdAt       DateTime @default(now())

  @@index([etablissementId])
  @@index([nom, prenom])
}

model Etablissement {
  id          String   @id @default(cuid())
  nom         String
  departement String
  commune     String
  etudiants   Etudiant[]
  directeurs  User[]
}

model Inscription {
  id            String   @id @default(cuid())
  etudiantId    String
  etudiant      Etudiant @relation(fields: [etudiantId], references: [id])
  anneeScolaire String
  niveau        String
  statut        String

  @@index([etudiantId])
}

model Note {
  id            String   @id @default(cuid())
  etudiantId    String
  etudiant      Etudiant @relation(fields: [etudiantId], references: [id])
  matiere       String
  valeur        Float
  periode       String
  anneeScolaire String
  createdAt     DateTime @default(now())

  @@index([etudiantId])
}

model Alerte {
  id            String   @id @default(cuid())
  etudiantId    String
  etudiant      Etudiant @relation(fields: [etudiantId], references: [id])
  type          String
  niveauRisque  String
  moyenneAvant  Float
  moyenneApres  Float
  ecartPourcent Float
  periode       String
  anneeScolaire String?
  statut        String   @default("active")
  createdAt     DateTime @default(now())
  // Date de la dernière aggravation (Moyen → Élevé) d'une alerte active ;
  // null si le niveau n'a jamais monté. Sert aux notifications de la cloche.
  niveauModifieLe DateTime?

  @@index([etudiantId])
  @@index([statut, createdAt])
  @@index([niveauModifieLe])
}

model Absence {
  id            String   @id @default(cuid())
  etudiantId    String
  etudiant      Etudiant @relation(fields: [etudiantId], references: [id])
  date          DateTime
  motif         String
  periode       String
  anneeScolaire String
  createdAt     DateTime @default(now())

  @@index([etudiantId])
  @@index([date])
}

model User {
  id               String         @id @default(cuid())
  email            String         @unique
  passwordHash     String
  nom              String
  prenom           String
  role             String         // "etudiant" | "enseignant" | "admin" | "directeur"
  etudiantId       String?        @unique
  etudiant         Etudiant?      @relation(fields: [etudiantId], references: [id])
  etablissementId  String?
  etablissement    Etablissement? @relation(fields: [etablissementId], references: [id])
  createdAt        DateTime       @default(now())
  actionLogs       ActionLog[]
  resetRequests    ResetRequest[]
}

model ResetRequest {
  id        String   @id @default(cuid())
  email     String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  traitee   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([traitee, createdAt])
}

model ActionLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action      String   // "NOTE_CREEE", "ALERTE_TRAITEE", ...
  description String
  entityType  String?  // "note", "absence", "alerte", "utilisateur"
  entityId    String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([action])
  @@index([userId])
}
