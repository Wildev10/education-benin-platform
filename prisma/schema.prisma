// Prisma 7 : client généré dans src/generated/prisma (ignoré par git, recréé par
// `prisma generate` à l'installation). Importer depuis "@/generated/prisma/client".
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// La connexion du CLI est dans prisma.config.ts ; celle de l'application passe
// par le driver adapter de src/lib/prisma.ts.
datasource db {
  provider = "postgresql"
}

model Etudiant {
  id              String   @id @default(cuid())
  nom             String
  prenom          String
  dateNaissance   DateTime
  sexe            String
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id])
  niveau          String
  inscriptions    Inscription[]
  notes           Note[]
  alertes         Alerte[]
  absences        Absence[]
  compte          User?
  createdAt       DateTime @default(now())

  @@index([etablissementId])
  @@index([nom, prenom])
}

model Etablissement {
  id          String   @id @default(cuid())
  nom         String
  departement String
  commune     String
  etudiants   Etudiant[]
  directeurs  User[]
}

model Inscription {
  id            String   @id @default(cuid())
  etudiantId    String
  etudiant      Etudiant @relation(fields: [etudiantId], references: [id])
  anneeScolaire String
  niveau        String
  statut        String

  @@index([etudiantId])
}

model Note {
  id            String   @id @default(cuid())
  etudiantId    String
  etudiant      Etudiant @relation(fields: [etudiantId], references: [id])
  matiere       String
  valeur        Float
  periode       String
  anneeScolaire String
  createdAt     DateTime @default(now())

  @@index([etudiantId])
}

model Alerte {
  id            String   @id @default(cuid())
  etudiantId    String
  etudiant      Etudiant @relation(fields: [etudiantId], references: [id])
  type          String
  niveauRisque  String
  moyenneAvant  Float
  moyenneApres  Float
  ecartPourcent Float
  periode       String
  anneeScolaire String?
  statut        String   @default("active")
  createdAt     DateTime @default(now())
  // Date de la dernière aggravation (Moyen → Élevé) d'une alerte active ;
  // null si le niveau n'a jamais monté. Sert aux notifications de la cloche.
  niveauModifieLe DateTime?
  // Suivi (src/lib/suivi-alertes.ts) : statut "active" + suiviDepuis = En cours
  // de suivi, "active" sans suiviDepuis = Nouvelle, "traitee" = Résolue.
  suiviDepuis     DateTime?
  resolueLe       DateTime?
  suivis          SuiviAlerte[]

  @@index([etudiantId])
  @@index([statut, createdAt])
  @@index([niveauModifieLe])
}

// Une étape du suivi d'une alerte : action menée, commentaire, auteur et date.
// auteurId null : action du système (réouverture automatique) ou compte supprimé ;
// auteurNom garde le nom affiché au moment de l'action.
model SuiviAlerte {
  id          String   @id @default(cuid())
  alerteId    String
  alerte      Alerte   @relation(fields: [alerteId], references: [id], onDelete: Cascade)
  auteurId    String?
  auteur      User?    @relation(fields: [auteurId], references: [id], onDelete: SetNull)
  auteurNom   String
  action      String   // "entretien_eleve" | "parents_convoques" | "soutien_scolaire" | "autre" | "reouverture" | "reouverture_auto"
  commentaire String
  statutAvant String   // "nouvelle" | "en_suivi" | "resolue"
  statutApres String
  createdAt   DateTime @default(now())

  @@index([alerteId, createdAt])
  @@index([auteurId])
}

model Absence {
  id            String   @id @default(cuid())
  etudiantId    String
  etudiant      Etudiant @relation(fields: [etudiantId], references: [id])
  date          DateTime
  motif         String
  periode       String
  anneeScolaire String
  createdAt     DateTime @default(now())

  @@index([etudiantId])
  @@index([date])
}

model User {
  id               String         @id @default(cuid())
  email            String         @unique
  passwordHash     String
  nom              String
  prenom           String
  role             String         // "etudiant" | "enseignant" | "admin" | "directeur"
  etudiantId       String?        @unique
  etudiant         Etudiant?      @relation(fields: [etudiantId], references: [id])
  etablissementId  String?
  etablissement    Etablissement? @relation(fields: [etablissementId], references: [id])
  createdAt        DateTime       @default(now())
  // Dernière ouverture de la cloche : les alertes créées ou aggravées après
  // cette date sont non lues. null : jamais ouverte (tout est non lu).
  notificationsVuesLe DateTime?
  actionLogs       ActionLog[]
  resetRequests    ResetRequest[]
  suivisAlertes    SuiviAlerte[]
}

model ResetRequest {
  id        String   @id @default(cuid())
  email     String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  traitee   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([traitee, createdAt])
}

model ActionLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action      String   // "NOTE_CREEE", "ALERTE_TRAITEE", ...
  description String
  entityType  String?  // "note", "absence", "alerte", "utilisateur"
  entityId    String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([action])
  @@index([userId])
}
